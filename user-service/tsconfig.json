{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "../shared/repositories/userNotification.repositories.ts"
  ],
  "references": [{ "path": "../shared" }, { "path": "../config" }]
}
