NODE_ENV=production
MAIN_PORT=3010

# Primary production DB URLs (PostgreSQL)
USERS_SERVICE_PRODUCTION_DB=postgres://USER:PASSWORD@ep-dawn-snowflake-a8t2wnjz-pooler.eastus2.azure.neon.tech:5432/DB_NAME?sslmode=require
FOUNDERS_LIST_PRODUCTION_DB=postgres://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
EDEDUN_PROD_DB=postgres://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Internal service ports
FOUNDERS_LIST_SERVICE_SERVER_PORT=3002
NOTIFICATION_SERVICE_PORT=3003
USERS_PORT=3004
LESSON_SERVICE_PORT=3005
EDEDUN_PORT=3006
PRONUNCIATION_SERVICE_PORT=3007
PAYMENT_SERVICE_PORT=3008

# Auth / app core
APP_JWT_SECRET=replace-with-secure-random-value
YORUBA_LANGUAGE_PROD_ID=replace-with-language-uuid
PRODUCTION_FRONTEND_URL=https://zabbot-app-development-4cnub.ondigitalocean.app
PROD_PASSWORD_RESET_URL=https://your-frontend.example/reset-password
GOOGLE_AUTH_FAILURE_URL=https://your-frontend.example/auth/failure

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ZABBOT_GOOGLE_REGISTER_CALLBACK_URL=https://your-backend.example/api/v1/users/auth/google/register/callback
ZABBOT_GOOGLE_LOGIN_CALLBACK_URL=https://your-backend.example/api/v1/users/auth/google/login/callback

# Service-to-service URLs
NOTIFICATION_SERVICE_ROUTE=http://localhost:3003/notification
PAYMENT_SERVICE_ROUTE=http://localhost:3008/payment-services
LOCAL_FOUNDERS_LIST_URL=http://localhost:3002

# Notifications / mail
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@your-domain.example
SENDGRID_FROM_NAME=YourApp
SENDGRID_SMTP_HOST=smtp.sendgrid.net
SENDGRID_SMTP_USERNAME=apikey

# Optional integrations (set when used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PRODUCTION_STRIPE_WEBHOOK_SECRET=
