{
  "name": "zabbot-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main-server.js",
  "scripts": {
    "buildAll": "ts-node buildAll.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/main-server.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec",
    "dev:start": "cross-env NODE_ENV=dev:start node dist/main-server.js",
    "install:all": "ts-node installAll.ts",
    "flyway:local": "flyway -configFiles=flyway.conf,flyway-local.conf",
    "flyway:online": "flyway -configFiles=flyway.conf,flyway-online.conf",
    "migrate:local": "flyway -configFiles=flyway.conf,flyway-local.conf migrate",
    "migrate:online": "flyway -configFiles=flyway.conf,flyway-online.conf migrate",
    "migrate:prod": "flyway -configFiles=flyway.conf,flyway-prod.conf migrate",
    "migrate:local:outOfOrder": "flyway -configFiles=flyway.conf,flyway-local.conf migrate -outOfOrder=true",
    "migrate:prod:outOfOrder": "flyway -configFiles=flyway.conf,flyway-prod.conf migrate -outOfOrder=true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tech-Managers-at-Zabbot/zabbot-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tech-Managers-at-Zabbot/zabbot-backend/issues"
  },
  "homepage": "https://github.com/Tech-Managers-at-Zabbot/zabbot-backend#readme",
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@mailchimp/mailchimp_transactional": "^1.1.2",
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/mail": "^8.1.5",
    "@types/lodash.merge": "^4.6.9",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "dotenv-flow": "^4.1.0",
    "dynamic-time-warping": "^1.0.0",
    "express": "^5.1.0",
    "ffmpeg": "^0.0.4",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "mailchimp_transactional": "^0.0.1-security",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "dotenv-cli": "^10.0.0"
  }
}
